ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string for the web app (per-user accounts + history).
# The CLI doesn't need this — it still uses the local JSON file.
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/leetcode_coach

# Signs the login session cookie. Auto-generated and appended to .env on
# first run if you don't set it yourself — set your own in production.
FLASK_SECRET_KEY=
